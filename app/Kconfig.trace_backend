# Application defaults for modem trace backends.
#
# Enable a trace backend by setting:
#   CONFIG_NRF_MODEM_LIB_TRACE=y   (enables the trace system)
#   CONFIG_SM_MODEM_TRACE_BACKEND_UART=y   (UART backend, shared with the Zephyr log backend)
#   CONFIG_SM_MODEM_TRACE_BACKEND_CMUX=y   (CMUX dedicated-channel backend)

if NRF_MODEM_LIB_TRACE

# Application-defined trace backends, added to the NRF_MODEM_LIB_TRACE_BACKEND choice
# that is declared by the nrf_modem_lib module.
choice NRF_MODEM_LIB_TRACE_BACKEND

config SM_MODEM_TRACE_BACKEND_CMUX
	bool "CMUX modem trace backend"
	depends on SM_CMUX_CHANNEL_COUNT > 2
	help
	  When CMUX is enabled, modem traces are transmitted on a dedicated CMUX channel.
	  The trace channel is the first channel after the AT command channel and the PPP channel.

config SM_MODEM_TRACE_BACKEND_UART
	bool "UART modem trace backend (shared with Zephyr log backend)"
	depends on UART_ASYNC_API
	help
	  Uses the zephyr,console UART as the modem trace backend, sharing it
	  with the Zephyr application log backend. The two are mutually exclusive:
	  only one can be active at a time. Switch at runtime with AT#XLOG / AT#XTRACE.

endchoice # NRF_MODEM_LIB_TRACE_BACKEND

# Start with traces off; the level is controlled at runtime via AT#XTRACE.
configdefault NRF_MODEM_LIB_TRACE_LEVEL_OVERRIDE
	default y

choice NRF_MODEM_LIB_TRACE_LEVEL_CHOICE
	default NRF_MODEM_LIB_TRACE_LEVEL_OFF
endchoice

endif # NRF_MODEM_LIB_TRACE
